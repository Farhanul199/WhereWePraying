/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.youtube.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://lh3.googleusercontent.com https://i.ytimg.com; connect-src 'self' https://api.aladhan.com https://api.alquran.cloud https://cdn.jsdelivr.net https://ummahapi.com https://fonts.googleapis.com https://geocoding-api.open-meteo.com https://api.open-meteo.com https://api.postcodes.io https://photon.komoot.io https://www.youtube.com; frame-src https://www.youtube-nocookie.com; media-src 'self' https://everyayah.com https://www.versebyversequran.com; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# ---- Browser caching (25 Sep 2026) ----
# Without these, Cloudflare Pages makes the browser re-check every file
# on every visit. Rules don't overlap on purpose (overlapping rules would
# merge two Cache-Control values). JS/CSS are safe to cache long because
# every reference carries a ?v= number that changes with the file.
# Images: 7 days (a replaced image with the same name shows within a week).
# /assets/data/*.json and root files keep the default (always re-check).
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=2592000
/assets/css/*
  Cache-Control: public, max-age=2592000
/assets/home/*
  Cache-Control: public, max-age=604800
/assets/hero/*
  Cache-Control: public, max-age=604800
/assets/dua/*
  Cache-Control: public, max-age=604800
/assets/icons/*
  Cache-Control: public, max-age=604800
/assets/prayertimes/*
  Cache-Control: public, max-age=604800
/assets/travel/*
  Cache-Control: public, max-age=604800
/assets/theme/*
  Cache-Control: public, max-age=604800
/assets/mosque/*
  Cache-Control: public, max-age=604800
/assets/coming-soon/*
  Cache-Control: public, max-age=604800
