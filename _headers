# ---- Browser caching (25 Sep 2026) ----
# Without these, Cloudflare Pages makes the browser re-check every file
# on every visit. Rules don't overlap on purpose (overlapping rules would
# merge two Cache-Control values). JS/CSS are safe to cache long because
# every reference carries a ?v= number that changes with the file.
# Images: 7 days (a replaced image with the same name shows within a week).
# /assets/data/*.json and root files keep the default (always re-check).
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=2592000
/assets/css/*
  Cache-Control: public, max-age=2592000
/assets/home/*
  Cache-Control: public, max-age=604800
/assets/hero/*
  Cache-Control: public, max-age=604800
/assets/dua/*
  Cache-Control: public, max-age=604800
/assets/icons/*
  Cache-Control: public, max-age=604800
/assets/prayertimes/*
  Cache-Control: public, max-age=604800
/assets/travel/*
  Cache-Control: public, max-age=604800
/assets/theme/*
  Cache-Control: public, max-age=604800
/assets/mosque/*
  Cache-Control: public, max-age=604800
/assets/coming-soon/*
  Cache-Control: public, max-age=604800

# ---- Admin + private pages (27 Sep 2026) ----
# Never indexed, never cached by browsers or proxies.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/xp1-admin.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/xp1-admin
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/delete-account.html
  X-Robots-Tag: noindex
/404.html
  X-Robots-Tag: noindex
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

# ---- Strict script policy for the app itself (28 Sep 2026) ----
# The app shell (index.html, served for every route below via _redirects)
# no longer has any inline <script> — those moved to /assets/js/boot/.
# So these routes get a second, stricter policy with NO 'unsafe-inline'
# for scripts: an injected <img onerror=...> or <script> can't run.
# Cloudflare joins it with the site-wide policy above; the browser then
# enforces BOTH, so the stricter script rule wins. Every other directive
# is identical, so it's also correct on its own.
# !! Adding an inline <script> or onclick="" to index.html will now be
# !! BLOCKED on these routes. Put new code in a .js file instead.
# !! A new app route added to _redirects must be added here too.
